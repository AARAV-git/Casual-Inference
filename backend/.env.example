# Copy this file to .env and fill in real values. .env is git-ignored.

# --- App ---
APP_NAME=causal-personalization-backend
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

# --- Database (PostgreSQL) ---
# Used for metadata only: experiments, models, causal_results, drift_results,
# experiment_runs, policies. Large datasets stay in data/processed/*.parquet.
POSTGRES_USER=causal_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=causal_personalization
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Assembled automatically by app/config.py if left blank:
# DATABASE_URL=postgresql+psycopg2://causal_admin:change_me@db:5432/causal_personalization

# --- Data paths ---
DATA_ROOT=./data
RAW_DATA_DIR=${DATA_ROOT}/raw
PROCESSED_DATA_DIR=${DATA_ROOT}/processed
SYNTHETIC_DATA_DIR=${DATA_ROOT}/synthetic

# --- MLflow ---
MLFLOW_TRACKING_URI=./experiments/mlruns
